{
  "expo": {
    "name": "Grindmates",
    "slug": "grindmates",
    "version": "1.0.0",
    "scheme": "grindmates",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#090D16",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090D16"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.grindmates.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Grindmates uses the camera to capture your post-workout check-in photo.",
        "NSPhotoLibraryUsageDescription": "Pick an existing photo for your check-in.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.grindmates.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090D16"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Grindmates uses the camera to capture your post-workout check-in photo."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "backgroundColor": "#090D16",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/grindmates"
    },
    "extra": {
      "supabaseUrl": "https://YOUR-PROJECT.supabase.co",
      "supabaseAnonKey": "YOUR-ANON-KEY",
      "router": {},
      "eas": {
        "projectId": "0958d7eb-ec3e-43a0-b48e-a66379d788b8"
      }
    },
    "icon": "./assets/icon.png"
  }
}
